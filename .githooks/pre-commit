#!/bin/sh
# main is protected: changes reach it only through pull requests, so no commit is made on main here.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ -z "$ALLOW_MAIN_COMMIT" ]; then
  echo "✗ Do not commit on main. First: git switch -c <type>/<topic>" >&2
  exit 1
fi
