@@ -0,0 +1,116 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+import assert from 'assert';
+import { $, append, getActiveWindow } from '../../../../../base/browser/dom.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { Extensions as ConfigurationExtensions, IConfigurationRegistry } from '../../../../../platform/configuration/common/configurationRegistry.js';
+import { Registry } from '../../../../../platform/registry/common/platform.js';
+import { ChatConfiguration, ChatProgressAnimation } from '../../../chat/common/constants.js';
+import { chatWorkingLogoAtlasFrameCount } from '../../../chat/browser/widget/chatWorkingLogoAtlas.js';
+import { chatWorkingLogoDrawDuration } from '../../../chat/browser/widget/chatWorkingLogoDraw.js';
+import { PINE_WORKING_MARK_DOCUMENT_HIDDEN, PINE_WORKING_MARK_LIT, PINE_WORKING_MARK_UNSEEN, PineWorkingMarkVisibility, pineWorkingMarkCss, pineWorkingMarkFrame, pineWorkingMarkSprite } from '../../browser/pineWorkingMark.js';
+
+suite('Pine working mark', () => {
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+	/** Long enough for an animation to start and the intersection observer to report (each at the next frame). */
+	const settle = () => new Promise(resolve => setTimeout(resolve, 100));
+
+	test('the product hides the VS Code mark with upstream\'s own No Icon setting', () => {
+		const defaults = Registry.as<IConfigurationRegistry>(ConfigurationExtensions.Configuration).getConfigurationDefaultsOverrides();
+		assert.strictEqual(defaults.get(ChatConfiguration.PersistentProgress)?.value, ChatProgressAnimation.DrawMonochromeNoIcon);
+	});
+
+	test('the frames keep upstream\'s rhythm: tied with an ease-out cubic, held, untied with an ease-in cubic, at rest', () => {
+		const at = (progress: number) => pineWorkingMarkFrame(Math.round(progress * chatWorkingLogoAtlasFrameCount));
+		const close = (actual: number, expected: number) => assert.ok(Math.abs(actual - expected) < 1e-9, `${actual} is not ${expected}`);
+		assert.strictEqual(chatWorkingLogoAtlasFrameCount, 320);
+		assert.strictEqual(chatWorkingLogoDrawDuration, 2667);
+		assert.deepStrictEqual(at(0), { tail: 0, head: 0 }, 'it starts from nothing');
+		close(at(0.2).head, 1 - 0.5 ** 3); // half the tie: easeOutCubic(0.5)
+		assert.strictEqual(at(0.2).tail, 0);
+		assert.deepStrictEqual(at(0.4), { tail: 0, head: 1 }, 'tied');
+		assert.deepStrictEqual(at(0.5), { tail: 0, head: 1 }, 'held');
+		close(at(0.75).tail, 0.5 ** 3); // half the untie: easeInCubic(0.5)
+		assert.strictEqual(at(0.75).head, 1);
+		assert.deepStrictEqual(at(0.95), { tail: 1, head: 1 }, 'at rest');
+	});
+
+	test('the sprite has one frame for each frame that shows anything, in both rows', () => {
+		let shown = 0;
+		for (let index = 0; index < chatWorkingLogoAtlasFrameCount; index++) {
+			const { tail, head } = pineWorkingMarkFrame(index);
+			shown += head > tail ? 1 : 0;
+		}
+		const sprite = pineWorkingMarkSprite();
+		assert.strictEqual(sprite.match(/clip-path="url\(#b\)"/g)?.length, shown);
+		assert.strictEqual(sprite.match(/clip-path="url\(#d\)"/g)?.length, shown);
+		assert.ok(sprite.includes(`width="${chatWorkingLogoAtlasFrameCount * 16}"`));
+	});
+
+	test('the mark moves only while active, seen and with motion on, at upstream\'s duration, and is still and whole otherwise', async () => {
+		const targetWindow = getActiveWindow();
+		const style = append(targetWindow.document.head, $('style'));
+		style.textContent = pineWorkingMarkCss();
+		// In the viewport whatever the test page holds, so being seen is decided by the rows themselves.
+		const root = append(targetWindow.document.body, $('div'));
+		root.style.cssText = 'position: fixed; top: 0; left: 0; width: 400px;';
+		store.add(new PineWorkingMarkVisibility());
+		try {
+			const logo = (container: string, active: boolean, parent: HTMLElement = root) => {
+				const holder = append(parent, $(`div.${container}`));
+				return append(holder, $(`span.chat-working-logo.chat-working-logo-no-icon.chat-working-logo-monochrome${active ? '.chat-working-logo-active' : ''}`));
+			};
+			const before = (element: HTMLElement) => targetWindow.getComputedStyle(element, '::before');
+			const after = (element: HTMLElement) => targetWindow.getComputedStyle(element, '::after');
+			// What actually runs ("Setting the display property to none will terminate any running animation", CSS
+			// Animations Level 1, 3; an unseen mark has none either).
+			const running = (element: HTMLElement) => targetWindow.document.getAnimations().filter(a => (a.effect as KeyframeEffect | null)?.target === element).length;
+
+			const moving = logo('monaco-enable-motion', true);
+			const reduced = logo('monaco-reduce-motion', true);
+			const inactive = logo('monaco-enable-motion', false);
+			const frozen = logo('monaco-enable-motion.disable-animations', true);
+			// A hidden document's root carries the class (visibilitychange); headless Chromium cannot hide its page.
+			const backgrounded = logo(`${PINE_WORKING_MARK_DOCUMENT_HIDDEN}.monaco-enable-motion`, true);
+			const hidden = logo('monaco-enable-motion', true);
+			hidden.parentElement!.style.display = 'none';
+			// A row clipped by its scrolled list but still attached and active.
+			const list = append(root, $('div'));
+			list.style.cssText = 'overflow: hidden; height: 4px;';
+			const spacer = append(list, $('div'));
+			spacer.style.height = '100px';
+			const clipped = logo('monaco-enable-motion', true, list);
+			await settle();
+
+			assert.strictEqual(before(moving).animationName, 'pine-working-mark-brackets');
+			assert.strictEqual(after(moving).animationName, 'pine-working-mark-dot');
+			assert.strictEqual(before(moving).animationDuration, `${chatWorkingLogoDrawDuration / 1000}s`);
+			assert.strictEqual(before(moving).animationTimingFunction, `steps(${chatWorkingLogoAtlasFrameCount})`, 'steps(count, end), which Chromium writes without its default end');
+			assert.strictEqual(after(moving).backgroundColor, 'rgb(47, 216, 146)', `the lit dot is ${PINE_WORKING_MARK_LIT}`);
+			assert.strictEqual(targetWindow.getComputedStyle(moving).filter, 'none', 'the dot is not greyed');
+			assert.strictEqual(before(moving).visibility, 'visible', 'shown in the place the hidden VS Code mark keeps');
+			assert.strictEqual(running(moving), 2);
+
+			for (const still of [reduced, inactive, frozen, clipped, backgrounded]) {
+				assert.strictEqual(before(still).animationName, 'none');
+				assert.strictEqual(after(still).animationName, 'none');
+				assert.strictEqual(running(still), 0);
+				assert.ok(before(still).maskPosition.startsWith('50%') || before(still).maskPosition.startsWith('50.'), `whole mark: ${before(still).maskPosition}`);
+			}
+			assert.strictEqual(running(hidden), 0, 'a hidden view runs nothing');
+			assert.ok(clipped.classList.contains(PINE_WORKING_MARK_UNSEEN), 'the clipped row is unseen');
+
+			// Scrolled into view, it plays, from its first frame.
+			spacer.style.height = '0px';
+			await settle();
+			assert.ok(!clipped.classList.contains(PINE_WORKING_MARK_UNSEEN));
+			assert.strictEqual(running(clipped), 2);
+			assert.ok((targetWindow.document.getAnimations().find(a => (a.effect as KeyframeEffect | null)?.target === clipped)!.currentTime as number) < 1000, 'it starts again rather than resuming');
+		} finally {
+			root.remove();
+			style.remove();
+		}
+	});
+});
