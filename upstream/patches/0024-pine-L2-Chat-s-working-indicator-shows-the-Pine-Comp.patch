+/*---------------------------------------------------------------------------------------------
+ *  Pine Drama Studio: Chat's working indicator shows the Pine Computer mark, drawn with upstream's own rhythm
+ *  (layer 2).
+ *--------------------------------------------------------------------------------------------*/
+
+import { addDisposableListener, isHTMLElement, onDidRegisterWindow } from '../../../../base/browser/dom.js';
+import { mainWindow, type CodeWindow } from '../../../../base/browser/window.js';
+import { Event } from '../../../../base/common/event.js';
+import { Disposable, DisposableStore, toDisposable } from '../../../../base/common/lifecycle.js';
+import { Extensions as ConfigurationExtensions, IConfigurationRegistry } from '../../../../platform/configuration/common/configurationRegistry.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { registerThemingParticipant } from '../../../../platform/theme/common/themeService.js';
+import { ChatConfiguration, ChatProgressAnimation } from '../../chat/common/constants.js';
+import { chatWorkingLogoAtlasFrameCount } from '../../chat/browser/widget/chatWorkingLogoAtlas.js';
+import { chatWorkingLogoDrawDuration, getChatWorkingLogoDrawFrame } from '../../chat/browser/widget/chatWorkingLogoDraw.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+
+// Upstream's working indicator draws the VS Code mark along a ribbon: tied with an ease-out cubic over 40% of a 2667 ms
+// cycle, held whole to 55%, untied from its start with an ease-in cubic to 95%, then a brief rest
+// (chatWorkingLogoDraw.ts, getChatWorkingLogoDrawFrame), played from a 320-frame atlas (chatWorkingLogoAtlas.ts). Its
+// "Draw (Monochrome, No Icon)" setting keeps the indicator's place in the row and hides the VS Code mark, without
+// drawing it (chatWorkingLogo.ts, isDrawAnimation; chatWorkingLogo.css, .chat-working-logo-no-icon). The Studio sets
+// that, and draws its own mark in the place it keeps: the same frames of upstream's frame function at the same count,
+// over a ribbon through the Pine Computer mark.
+
+/** Pixels of one frame: the Pine Computer mark's own 16 by 16 grid. */
+const SIZE = 16;
+/**
+ * The Pine Computer mark (lit): four corner brackets and a lit dot. The same shapes as the Studio extension's
+ * media/pine-computer-lit.svg, a copy of brand/system/mark/favicon-lit.svg (pine-computer-narrative).
+ */
+const BRACKETS = 'M0 0h5v2H2v3H0zM11 0h5v5h-2V2h-3zM0 11h2v3h3v2H0zM14 11h2v5h-5v-2h3z';
+const DOT = { cx: 8, cy: 8, r: 3.25 };
+/** The lit dot's colour in the mark. */
+export const PINE_WORKING_MARK_LIT = '#2fd892';
+/**
+ * The ribbon the mark is drawn along, as upstream's runs through the VS Code mark's bands: clockwise down the centre line
+ * of the brackets from the top-left one (the gaps between them show nothing), then into the dot and once round it. Its
+ * width covers each bracket (2 wide) and the dot (r 3.25 from a 1.625 circle); outside the mark it shows nothing.
+ */
+const RIBBON = 'M1 5V1H15V15H1V11L6.375 8A1.625 1.625 0 1 1 9.625 8A1.625 1.625 0 1 1 6.375 8';
+const RIBBON_WIDTH = 3.5;
+
+/** The part of the ribbon frame `index` shows, as fractions of its length: upstream's tail and head for the same frame. */
+export function pineWorkingMarkFrame(index: number): { readonly tail: number; readonly head: number } {
+	// The whole ribbon is what upstream holds assembled, mid-cycle.
+	const length = getChatWorkingLogoDrawFrame(0.5).head;
+	const frame = getChatWorkingLogoDrawFrame(index / chatWorkingLogoAtlasFrameCount);
+	return { tail: frame.tail / length, head: frame.head / length };
+}
+
+const round = (value: number) => Number(value.toFixed(5));
+
+/**
+ * The frames side by side, the brackets in the first row and the dot in the second, each the ribbon's shown part clipped
+ * to that part of the mark. Used as a mask, so each row takes its own colour.
+ */
+export function pineWorkingMarkSprite(): string {
+	const frames: string[] = [];
+	for (let index = 0; index < chatWorkingLogoAtlasFrameCount; index++) {
+		const { tail, head } = pineWorkingMarkFrame(index);
+		if (head <= tail) {
+			continue;
+		}
+		const shown = `stroke-dasharray="${round(head - tail)} 2" stroke-dashoffset="${round(-tail)}"`;
+		frames.push(`<g transform="translate(${index * SIZE} 0)" clip-path="url(#b)"><use href="#r" ${shown}/></g>`);
+		frames.push(`<g transform="translate(${index * SIZE} ${SIZE})" clip-path="url(#d)"><use href="#r" ${shown}/></g>`);
+	}
+	const width = chatWorkingLogoAtlasFrameCount * SIZE;
+	return `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${2 * SIZE}" viewBox="0 0 ${width} ${2 * SIZE}">`
+		+ `<defs><path id="r" d="${RIBBON}" pathLength="1" fill="none" stroke="#000" stroke-width="${RIBBON_WIDTH}"/>`
+		+ `<clipPath id="b"><path d="${BRACKETS}"/></clipPath><clipPath id="d"><circle cx="${DOT.cx}" cy="${DOT.cy}" r="${DOT.r}"/></clipPath></defs>`
+		+ frames.join('') + '</svg>';
+}
+
+/** On a mark not known to be seen: it stands still, and plays again from its first frame once seen. */
+export const PINE_WORKING_MARK_UNSEEN = 'pine-working-mark-unseen';
+const UNSEEN = PINE_WORKING_MARK_UNSEEN;
+/** On a window's root while its document is hidden: no mark there plays, and each starts again when it is shown. */
+export const PINE_WORKING_MARK_DOCUMENT_HIDDEN = 'pine-working-mark-document-hidden';
+const ANIMATIONS = new Set(['pine-working-mark-brackets', 'pine-working-mark-dot']);
+
+/** The mask position that shows frame `index`: the sprite is `count` frames wide and the element one. */
+function framePosition(index: number): string {
+	return `${round(100 * index / (chatWorkingLogoAtlasFrameCount - 1))}%`;
+}
+
+/**
+ * The rules that draw the mark. Still, it shows the frame upstream shows still, the mark whole (renderDrawFrame(0.5)).
+ * It moves only while the indicator is active, seen (PineWorkingMarkVisibility) and motion is not reduced: the workbench marks each window
+ * `.monaco-enable-motion` or `.monaco-reduce-motion` from the same accessibility service upstream asks
+ * (accessibilityService.ts, updateContainerClasses; chatWorkingLogo.ts, isMotionReduced), and fixtures that freeze
+ * motion with `.disable-animations` stay still, as upstream's do.
+ */
+export function pineWorkingMarkCss(): string {
+	const count = chatWorkingLogoAtlasFrameCount;
+	const mark = '.chat-working-logo.chat-working-logo-no-icon';
+	const sprite = `url("data:image/svg+xml,${encodeURIComponent(pineWorkingMarkSprite())}")`;
+	const still = framePosition(count / 2);
+	// steps(count, end) from frame 0 to one frame past the last shows frames 0 to count - 1, one per step, as upstream's
+	// atlas keyframes do (getChatWorkingLogoAtlasKeyframes: steps(1, end) per frame).
+	const past = `${round(100 * count / (count - 1))}%`;
+	return [
+		// The class comes with the monochrome one (chatWorkingLogo.ts, setAnimation), whose grayscale would grey the lit dot.
+		`${mark} { filter: none; }`,
+		`${mark}::before, ${mark}::after { content: ''; position: absolute; inset: 0; visibility: visible; mask-image: ${sprite}; mask-repeat: no-repeat; mask-size: ${count * 100}% 200%; }`,
+		`${mark}::before { background-color: var(--vscode-icon-foreground); mask-position: ${still} 0%; }`,
+		`${mark}::after { background-color: ${PINE_WORKING_MARK_LIT}; mask-position: ${still} 100%; }`,
+		`@keyframes pine-working-mark-brackets { from { mask-position: 0% 0%; } to { mask-position: ${past} 0%; } }`,
+		`@keyframes pine-working-mark-dot { from { mask-position: 0% 100%; } to { mask-position: ${past} 100%; } }`,
+		`.monaco-enable-motion ${mark}.chat-working-logo-active::before { animation: pine-working-mark-brackets ${chatWorkingLogoDrawDuration}ms steps(${count}, end) infinite; }`,
+		`.monaco-enable-motion ${mark}.chat-working-logo-active::after { animation: pine-working-mark-dot ${chatWorkingLogoDrawDuration}ms steps(${count}, end) infinite; }`,
+		`.disable-animations ${mark}.chat-working-logo-active::before, .disable-animations ${mark}.chat-working-logo-active::after { animation: none; }`,
+		`.monaco-enable-motion ${mark}.chat-working-logo-active.${UNSEEN}::before, .monaco-enable-motion ${mark}.chat-working-logo-active.${UNSEEN}::after, .${PINE_WORKING_MARK_DOCUMENT_HIDDEN} ${mark}.chat-working-logo-active::before, .${PINE_WORKING_MARK_DOCUMENT_HIDDEN} ${mark}.chat-working-logo-active::after { animation: none; }`,
+	].join('\n');
+}
+
+/**
+ * Plays a mark only while it is seen, by the signal upstream's own mark plays by (chatWorkingLogo.ts, observeVisibility,
+ * and restartDrawAnimation): its element intersects the viewport (an IntersectionObserver, which counts clipping by a
+ * scrolled ancestor) and its document is not hidden. Like upstream's, a mark counts as unseen until the observer first
+ * says otherwise, and starts from its first frame when it becomes seen. A mark is observed from its own animation's start,
+ * which bubbles to the document, and is let go when that animation is cancelled (the row is no longer active) or the
+ * observer finds it detached; nothing scans the DOM.
+ */
+export class PineWorkingMarkVisibility extends Disposable implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.pineWorkingMarkVisibility';
+
+	constructor() {
+		super();
+		this._register(Event.runAndSubscribe(onDidRegisterWindow, ({ window, disposables }) => this.observe(window, disposables), { window: mainWindow, disposables: this._store }));
+	}
+
+	private observe(targetWindow: CodeWindow, disposables: DisposableStore): void {
+		const observer = new targetWindow.IntersectionObserver((entries: IntersectionObserverEntry[]) => {
+			for (const entry of entries) {
+				// Detached, or out of view and no longer active: nothing to play, so it is let go (and observed again from its
+				// next start), which keeps no removed row alive.
+				if (!entry.target.isConnected || (!entry.isIntersecting && !entry.target.classList.contains('chat-working-logo-active'))) {
+					forget(entry.target);
+					continue;
+				}
+				entry.target.classList.toggle(UNSEEN, !entry.isIntersecting);
+			}
+		});
+		const observed = new WeakSet<Element>();
+		const forget = (element: Element) => {
+			observer.unobserve(element);
+			observed.delete(element);
+			element.classList.remove(UNSEEN);
+		};
+		disposables.add(toDisposable(() => observer.disconnect()));
+		disposables.add(addDisposableListener(targetWindow.document, 'animationstart', (event: AnimationEvent) => {
+			const element = event.target;
+			if (ANIMATIONS.has(event.animationName) && isHTMLElement(element) && !observed.has(element)) {
+				observed.add(element);
+				element.classList.add(UNSEEN);
+				observer.observe(element);
+			}
+		}));
+		disposables.add(addDisposableListener(targetWindow.document, 'animationcancel', (event: AnimationEvent) => {
+			const element = event.target;
+			// Cancelled because the row is no longer active; the unseen class's own cancel keeps the observation.
+			if (ANIMATIONS.has(event.animationName) && isHTMLElement(element) && !element.classList.contains('chat-working-logo-active')) {
+				forget(element);
+			}
+		}));
+		const root = targetWindow.document.documentElement;
+		const hidden = () => root.classList.toggle(PINE_WORKING_MARK_DOCUMENT_HIDDEN, targetWindow.document.hidden);
+		hidden();
+		disposables.add(addDisposableListener(targetWindow.document, 'visibilitychange', hidden));
+		disposables.add(toDisposable(() => root.classList.remove(PINE_WORKING_MARK_DOCUMENT_HIDDEN)));
+	}
+}
+
+registerWorkbenchContribution2(PineWorkingMarkVisibility.ID, PineWorkingMarkVisibility, WorkbenchPhase.AfterRestored);
+
+// Upstream's own setting, its "No Icon" value: the indicator keeps its place and Draw's text, and the VS Code mark is
+// neither shown nor drawn. A person who chooses another value gets upstream's mark.
+Registry.as<IConfigurationRegistry>(ConfigurationExtensions.Configuration).registerDefaultConfigurations([{
+	overrides: { [ChatConfiguration.PersistentProgress]: ChatProgressAnimation.DrawMonochromeNoIcon },
+}]);
+
+let css: string | undefined;
+registerThemingParticipant((_theme, collector) => collector.addRule(css ??= pineWorkingMarkCss()));
diff --git a/src/vs/workbench/contrib/pine/test/browser/pineWorkingMark.test.ts b/src/vs/workbench/contrib/pine/test/browser/pineWorkingMark.test.ts
