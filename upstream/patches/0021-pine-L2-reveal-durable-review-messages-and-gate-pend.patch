 export const prepareProjectChatCommand = 'pine.workbench.prepareProjectChat';
 
+// Durable review identity is trusted response metadata, not a rendered row index or Computer id.
+CommandsRegistry.registerCommand('pine.workbench.revealReview', async (accessor, resource: string, reviewId: string) => {
+	const uri = URI.parse(resource);
+	if (uri.scheme !== 'pine-computer' || typeof reviewId !== 'string' || !reviewId) {
+		throw new Error('Invalid Pine review destination.');
+	}
+	const widget = await accessor.get(IChatWidgetService).openSession(uri, ChatViewPaneTarget);
+	const message = widget?.viewModel?.getItems().find(item => isResponseVM(item) && item.result?.metadata?.pineReviewId === reviewId);
+	if (!widget || !message) { throw new Error('The review message is unavailable in this conversation. Reload its history and retry.'); }
+	widget.reveal(message);
+	widget.focus(message);
+});
+
 // Wait for the real native restore, including extension-provider history, before choosing a default.
