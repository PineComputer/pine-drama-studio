 import assert from 'assert';
+import { IConfigurationService, type IConfigurationChangeEvent, type IConfigurationOverrides } from '../../../../../platform/configuration/common/configuration.js';
 import { CommandsRegistry } from '../../../../../platform/commands/common/commands.js';
 import { TestInstantiationService } from '../../../../../platform/instantiation/test/common/instantiationServiceMock.js';
 import { upcastPartial } from '../../../../../base/test/common/mock.js';
+import { Emitter } from '../../../../../base/common/event.js';
 import { URI } from '../../../../../base/common/uri.js';
 import { IViewsService } from '../../../../services/views/common/viewsService.js';
 import { IAgentSessionsService } from '../../../chat/browser/agentSessions/agentSessionsService.js';
 import type { IAgentSession } from '../../../chat/browser/agentSessions/agentSessionsModel.js';
