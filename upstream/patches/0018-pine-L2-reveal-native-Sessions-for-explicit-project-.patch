 import type { ChatWidget } from '../../../chat/browser/widget/chatWidget.js';
-import { ChatViewId } from '../../../chat/browser/chat.js';
+import { ChatViewId, type IChatWidgetViewModelChangeEvent } from '../../../chat/browser/chat.js';
 import { prepareProjectChatCommand } from '../../browser/pineProjectChat.js';
 import { pineWelcomeStartEntries } from '../../browser/pineWelcome.js';
 
@@ -45,4 +47,46 @@ suite('Pine project entry', () => {
 			assert.deepStrictEqual(calls, ['open', 'restore', 'list', 'pin']);
 		} finally { service.dispose(); }
 	});
+	test('explicit Sessions navigation temporarily reveals the native list without replacing Chat', async () => {
+		const service = new TestInstantiationService();
+		const changed = new Emitter<IChatWidgetViewModelChangeEvent>();
+		const visibility = new Emitter<boolean>();
+		const opened = new Emitter<URI>();
+		const configuration = new Emitter<IConfigurationChangeEvent>();
+		let reveals = 0; let focused = 0; let orientation = 'sideBySide'; let enabled = true; let bodyVisible = true;
+		let restoreReady: Promise<void> = Promise.resolve();
+		const resource = URI.parse('pine-computer:/episode');
+		const view = upcastPartial<ChatViewPane>({
+			whenSessionRestored: async () => { await restoreReady; },
+			revealSessionsList: () => { reveals++; return { dispose: () => { reveals--; } }; },
+			focusSessions: () => { focused++; return true; },
+			onDidChangeBodyVisibility: visibility.event, isBodyVisible: () => bodyVisible,
+			agentSessionsControl: upcastPartial<NonNullable<ChatViewPane['agentSessionsControl']>>({ onDidOpenSession: opened.event }),
+			widget: upcastPartial<ChatWidget>({ onDidChangeViewModel: changed.event, viewModel: upcastPartial<NonNullable<ChatWidget['viewModel']>>({ sessionResource: resource }) }),
+		});
+		service.stub(IViewsService, upcastPartial<IViewsService>({ openView: async <T>() => view as T }));
+		service.stub(IConfigurationService, upcastPartial<IConfigurationService>({ onDidChangeConfiguration: configuration.event, getValue: <T>(key?: string | IConfigurationOverrides) => (key === 'chat.viewSessions.enabled' ? enabled : orientation) as T }));
+		const show = () => service.invokeFunction(accessor => CommandsRegistry.getCommand('pine.workbench.showProjectSessions')!.handler(accessor));
+		try {
+			await show(); assert.strictEqual(reveals, 1); assert.strictEqual(focused, 1);
+			assert.strictEqual(view.widget.viewModel!.sessionResource, resource);
+			changed.fire({ previousSessionResource: resource, currentSessionResource: URI.parse('pine-computer:/main') });
+			assert.strictEqual(reveals, 0);
+			await show(); assert.strictEqual(reveals, 1);
+			visibility.fire(false); assert.strictEqual(reveals, 0);
+			await show(); opened.fire(resource); assert.strictEqual(reveals, 0, 'opening the current row also ends navigation');
+			await show(); configuration.fire(upcastPartial<IConfigurationChangeEvent>({ affectsConfiguration: name => name === 'chat.viewSessions.orientation' }));
+			assert.strictEqual(reveals, 1, 'the delayed Show Sidebar sideBySide event does not end its own reveal');
+			orientation = 'stacked'; configuration.fire(upcastPartial<IConfigurationChangeEvent>({ affectsConfiguration: name => name === 'chat.viewSessions.orientation' }));
+			assert.strictEqual(reveals, 0, 'native Hide Sessions changes layout without hiding Chat');
+			await show(); enabled = false; configuration.fire(upcastPartial<IConfigurationChangeEvent>({ affectsConfiguration: name => name === 'chat.viewSessions.enabled' }));
+			assert.strictEqual(reveals, 0, 'disabling the list releases the reveal too');
+			let completeRestore!: () => void; restoreReady = new Promise<void>(resolve => { completeRestore = resolve; });
+			const opening = show(); await Promise.resolve(); bodyVisible = false; visibility.fire(false); completeRestore(); await opening;
+			assert.strictEqual(reveals, 0, 'hiding the body during restoration never acquires a late reveal');
+			assert.strictEqual(opened.hasListeners(), false); assert.strictEqual(configuration.hasListeners(), false);
+			assert.strictEqual(changed.hasListeners(), false); assert.strictEqual(visibility.hasListeners(), false);
+		} finally { changed.dispose(); visibility.dispose(); opened.dispose(); configuration.dispose(); service.dispose(); }
+	});
+
 });
