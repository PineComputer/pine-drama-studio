Subject: [PATCH 18/31] pine(L2): reveal native Sessions for explicit project
 navigation


diff --git a/src/vs/workbench/contrib/pine/browser/pineProjectChat.ts b/src/vs/workbench/contrib/pine/browser/pineProjectChat.ts
index e092963fc98..1353db33fbb 100644
--- a/src/vs/workbench/contrib/pine/browser/pineProjectChat.ts
+++ b/src/vs/workbench/contrib/pine/browser/pineProjectChat.ts
@@ -1,8 +1,12 @@
 /*---------------------------------------------------------------------------------------------
  * Native Chat restoration bridge for Pine. Private extension API exposes local-provider sessions only.
  *--------------------------------------------------------------------------------------------*/
+import { DisposableStore } from '../../../../base/common/lifecycle.js';
+import { Event } from '../../../../base/common/event.js';
 import { URI } from '../../../../base/common/uri.js';
 import { IAgentSessionsService } from '../../chat/browser/agentSessions/agentSessionsService.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { ChatConfiguration } from '../../chat/common/constants.js';
 import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
 import { IViewsService } from '../../../services/views/common/viewsService.js';
 import { ChatViewId } from '../../chat/browser/chat.js';
@@ -23,3 +27,25 @@ CommandsRegistry.registerCommand(prepareProjectChatCommand, async (accessor, mai
 	sessions.getSession(URI.parse(mainResource))?.setPinned(true);
 	return view.widget?.viewModel?.sessionResource.toString();
 });
+
+// Native setup/welcome can hide the list even after Show Agent Sessions Sidebar changes its layout.
+// An explicit navigation reveal lasts only until selection or hiding the view, preserving the selected Chat/draft.
+CommandsRegistry.registerCommand('pine.workbench.showProjectSessions', async accessor => {
+	const configuration = accessor.get(IConfigurationService);
+	const views = accessor.get(IViewsService);
+	const view = await views.openView<ChatViewPane>(ChatViewId, true);
+	if (!view) { return; }
+	await view.whenSessionRestored();
+	if (!view.isBodyVisible()) { return; }
+	const reveal = new DisposableStore();
+	reveal.add(view.revealSessionsList());
+	reveal.add(Event.once(view.widget.onDidChangeViewModel)(() => reveal.dispose()));
+	if (view.agentSessionsControl) { reveal.add(Event.once(view.agentSessionsControl.onDidOpenSession)(() => reveal.dispose())); }
+	reveal.add(configuration.onDidChangeConfiguration(event => {
+		const disabled = event.affectsConfiguration(ChatConfiguration.ChatViewSessionsEnabled) && !configuration.getValue<boolean>(ChatConfiguration.ChatViewSessionsEnabled);
+		const stacked = event.affectsConfiguration(ChatConfiguration.ChatViewSessionsOrientation) && configuration.getValue<string>(ChatConfiguration.ChatViewSessionsOrientation) === 'stacked';
+		if (disabled || stacked) { reveal.dispose(); }
+	}));
+	reveal.add(Event.filter(view.onDidChangeBodyVisibility, visible => !visible)(() => reveal.dispose()));
+	view.focusSessions();
+});
