From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pine Drama Studio Authors <authors@example.invalid>
Date: Wed, 4 Nov 2026 20:01:33 -0800
Subject: [PATCH 09/32] pine(L2): add the Pine Computer Accounts action


diff --git a/src/vs/workbench/contrib/pine/browser/pineAccounts.ts b/src/vs/workbench/contrib/pine/browser/pineAccounts.ts
new file mode 100644
index 00000000000..42733c9c3f2
--- /dev/null
+++ b/src/vs/workbench/contrib/pine/browser/pineAccounts.ts
@@ -0,0 +1,10 @@
+/*---------------------------------------------------------------------------------------------
+ *  Pine Drama Studio account entry (layer 2). The extension owns credentials and native key input.
+ *--------------------------------------------------------------------------------------------*/
+import { Action } from '../../../../base/common/actions.js';
+import { localize } from '../../../../nls.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+
+export function pineAccountActions(commands: Pick<ICommandService, 'executeCommand'>): Action[] {
+	return [new Action('pineDrama.connection', localize('pineComputerConnection', "Pine Computer…"), undefined, true, () => commands.executeCommand('pineDrama.connection'))];
+}
diff --git a/src/vs/workbench/contrib/pine/test/browser/pineAccounts.test.ts b/src/vs/workbench/contrib/pine/test/browser/pineAccounts.test.ts
new file mode 100644
index 00000000000..98db1bce1d7
--- /dev/null
+++ b/src/vs/workbench/contrib/pine/test/browser/pineAccounts.test.ts
@@ -0,0 +1,18 @@
+/*---------------------------------------------------------------------------------------------
+ *  Pine Drama Studio Accounts regression: no inherited authentication or model-provider action.
+ *--------------------------------------------------------------------------------------------*/
+import assert from 'assert';
+import { pineAccountActions } from '../../browser/pineAccounts.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+
+suite('Pine Accounts', () => {
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+	test('the native menu contains only the Pine connection command and dispatches it', async () => {
+		const calls: string[] = [];
+		const actions = pineAccountActions({ executeCommand: async <T>(id: string) => { calls.push(id); return undefined as T; } });
+		for (const action of actions) { store.add(action); }
+		assert.deepStrictEqual(actions.map(action => [action.id, action.label]), [['pineDrama.connection', 'Pine Computer…']]);
+		await actions[0].run();
+		assert.deepStrictEqual(calls, ['pineDrama.connection']);
+	});
+});
