diff --git a/src/vs/workbench/contrib/pine/browser/pineProjectChat.ts b/src/vs/workbench/contrib/pine/browser/pineProjectChat.ts
index 1353db33fbb..fd47666bcc1 100644
--- a/src/vs/workbench/contrib/pine/browser/pineProjectChat.ts
+++ b/src/vs/workbench/contrib/pine/browser/pineProjectChat.ts
@@ -10,6 +10,7 @@ import { ChatConfiguration } from '../../chat/common/constants.js';
 import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
 import { IViewsService } from '../../../services/views/common/viewsService.js';
 import { ChatViewId } from '../../chat/browser/chat.js';
+import { isUntitledChatSession } from '../../chat/common/model/chatUri.js';
 import type { ChatViewPane } from '../../chat/browser/widgetHosts/viewPane/chatViewPane.js';
 
 export const prepareProjectChatCommand = 'pine.workbench.prepareProjectChat';
@@ -25,7 +26,13 @@ CommandsRegistry.registerCommand(prepareProjectChatCommand, async (accessor, mai
 	// The primary uses native pin state/grouping, never invented activity times or a duplicate home button.
 	await sessions.model.resolve('pine-computer');
 	sessions.getSession(URI.parse(mainResource))?.setPinned(true);
-	return view.widget?.viewModel?.sessionResource.toString();
+	const widget = view.widget;
+	const resource = widget?.viewModel?.sessionResource;
+	if (!resource) { return undefined; }
+	// New Chat has no provider history before first send. Preserve its native input, including attachment-only drafts.
+	const isUntitledDraft = resource.scheme === 'pine-computer' && isUntitledChatSession(resource)
+		&& (widget.getInput().length > 0 || widget.attachmentModel.attachments.length > 0);
+	return { resource: resource.toString(), isUntitledDraft };
 });
 
 // Native setup/welcome can hide the list even after Show Agent Sessions Sidebar changes its layout.
