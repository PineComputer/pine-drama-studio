+	for (const input of ['text', 'attachments', 'empty', 'other-provider'] as const) {
+		test(`native untitled restoration reports ${input} without materializing a saved Chat`, async () => {
+			const service = new TestInstantiationService();
+			const resource = getNewChatSessionResource(input === 'other-provider' ? 'other-provider' : 'pine-computer');
+			const view = upcastPartial<ChatViewPane>({
+				whenSessionRestored: async () => {},
+				widget: upcastPartial<ChatWidget>({
+					viewModel: upcastPartial<NonNullable<ChatWidget['viewModel']>>({ sessionResource: resource }),
+					getInput: () => input === 'text' || input === 'other-provider' ? 'OFFLINE unsent draft' : '',
+					attachmentModel: upcastPartial<ChatWidget['attachmentModel']>({ attachments: input === 'attachments' ? [upcastPartial<ChatWidget['attachmentModel']['attachments'][number]>({ id: 'offline-script' })] : [] }),
+				}),
+			});
+			service.stub(IViewsService, upcastPartial<IViewsService>({ openView: async <T>() => view as T }));
+			service.stub(IAgentSessionsService, upcastPartial<IAgentSessionsService>({ model: upcastPartial<IAgentSessionsService['model']>({ resolve: async () => {} }), getSession: () => undefined }));
+			try {
+				const restored = await service.invokeFunction(accessor => CommandsRegistry.getCommand(prepareProjectChatCommand)!.handler(accessor, 'pine-computer:/main'));
+				assert.deepStrictEqual(restored, { resource: resource.toString(), isUntitledDraft: input === 'text' || input === 'attachments' });
+			} finally { service.dispose(); }
+		});
+	}
+
