+/*---------------------------------------------------------------------------------------------
+ * Native Chat restoration bridge for Pine. Private extension API exposes local-provider sessions only.
+ *--------------------------------------------------------------------------------------------*/
+import { URI } from '../../../../base/common/uri.js';
+import { IAgentSessionsService } from '../../chat/browser/agentSessions/agentSessionsService.js';
+import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
+import { IViewsService } from '../../../services/views/common/viewsService.js';
+import { ChatViewId } from '../../chat/browser/chat.js';
+import type { ChatViewPane } from '../../chat/browser/widgetHosts/viewPane/chatViewPane.js';
+
+export const prepareProjectChatCommand = 'pine.workbench.prepareProjectChat';
+
+// Wait for the real native restore, including extension-provider history, before choosing a default.
+// This command restores/selects native UI state only; it creates no conversation and dispatches no request.
+CommandsRegistry.registerCommand(prepareProjectChatCommand, async (accessor, mainResource: string) => {
+	const views = accessor.get(IViewsService);
+	const sessions = accessor.get(IAgentSessionsService);
+	const view = await views.openView<ChatViewPane>(ChatViewId, false);
+	if (!view) { return undefined; }
+	await view.whenSessionRestored();
+	// The primary uses native pin state/grouping, never invented activity times or a duplicate home button.
+	await sessions.model.resolve('pine-computer');
+	sessions.getSession(URI.parse(mainResource))?.setPinned(true);
+	return view.widget?.viewModel?.sessionResource.toString();
+});
