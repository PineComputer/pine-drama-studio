+import assert from 'assert';
+import { CommandsRegistry } from '../../../../../platform/commands/common/commands.js';
+import { TestInstantiationService } from '../../../../../platform/instantiation/test/common/instantiationServiceMock.js';
+import { upcastPartial } from '../../../../../base/test/common/mock.js';
+import { URI } from '../../../../../base/common/uri.js';
+import { IViewsService } from '../../../../services/views/common/viewsService.js';
+import { IAgentSessionsService } from '../../../chat/browser/agentSessions/agentSessionsService.js';
+import type { IAgentSession } from '../../../chat/browser/agentSessions/agentSessionsModel.js';
+import type { ChatViewPane } from '../../../chat/browser/widgetHosts/viewPane/chatViewPane.js';
+import type { ChatWidget } from '../../../chat/browser/widget/chatWidget.js';
+import { ChatViewId } from '../../../chat/browser/chat.js';
+import { prepareProjectChatCommand } from '../../browser/pineProjectChat.js';
+import { pineWelcomeStartEntries } from '../../browser/pineWelcome.js';
+
+suite('Pine project entry', () => {
+	test('Welcome dispatches the two existing project commands without replacing native Recent', () => {
+		assert.deepStrictEqual(pineWelcomeStartEntries.map(entry => entry.content.command), ['command:pineDrama.newProject', 'command:pineDrama.openProject']);
+	});
+
+	test('native restoration preserves extension-provider episodes before pinning the main home', async () => {
+		const service = new TestInstantiationService();
+		const calls: string[] = [];
+		let resolveRestore!: () => void;
+		const restored = new Promise<void>(resolve => { resolveRestore = resolve; });
+		const view = upcastPartial<ChatViewPane>({
+			whenSessionRestored: async () => { calls.push('restore'); await restored; },
+			widget: upcastPartial<ChatWidget>({ viewModel: upcastPartial<NonNullable<ChatWidget['viewModel']>>({ sessionResource: URI.parse('pine-computer:/episode') }) }),
+		});
+		service.stub(IViewsService, upcastPartial<IViewsService>({
+			openView: async <T>(id: string, focus?: boolean) => { assert.strictEqual(id, ChatViewId); assert.strictEqual(focus, false); calls.push('open'); return view as T; },
+		}));
+		service.stub(IAgentSessionsService, upcastPartial<IAgentSessionsService>({
+			model: upcastPartial<IAgentSessionsService['model']>({ resolve: async provider => { assert.strictEqual(provider, 'pine-computer'); calls.push('list'); } }),
+			getSession: resource => { assert.strictEqual(resource.toString(), 'pine-computer:/main'); return upcastPartial<IAgentSession>({ setPinned: value => { assert.strictEqual(value, true); calls.push('pin'); } }); },
+		}));
+		try {
+			const selected = service.invokeFunction(accessor => CommandsRegistry.getCommand(prepareProjectChatCommand)!.handler(accessor, 'pine-computer:/main'));
+			await Promise.resolve(); assert.deepStrictEqual(calls, ['open', 'restore']);
+			resolveRestore();
+			assert.strictEqual(await selected, 'pine-computer:/episode');
+			assert.deepStrictEqual(calls, ['open', 'restore', 'list', 'pin']);
+		} finally { service.dispose(); }
+	});
+});
