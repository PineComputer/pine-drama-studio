@@ -1175,6 +1179,43 @@ suite('MainThreadChatSessions', function () {
 
 		mainThread.$unregisterChatSessionItemController(controllerHandle);
 	});
+
+	test('an item shows the provider\'s description again when the turn that described it ends', async function () {
+		const sessionScheme = 'test-session-type';
+		const controllerHandle = 0;
+		mainThread.$registerChatSessionItemController(controllerHandle, sessionScheme, false);
+
+		const resource = URI.parse(`${sessionScheme}:/session-a`);
+		const timing = { created: 0, lastRequestStarted: undefined, lastRequestEnded: undefined };
+		await mainThread.$addOrUpdateChatSessionItem(controllerHandle, { resource, label: 'Session A', description: 'From the provider', timing });
+
+		const progress: IChatProgressMessage = { kind: 'progressMessage', content: new MarkdownString('Collecting the result') };
+		const response = { isComplete: false, isCanceled: false, response: { value: [progress] } };
+		const request = { response } as unknown as IChatRequestModel;
+		const changed = disposables.add(new Emitter<IChatChangeEvent>());
+		const model = new class extends mock<IChatModel>() {
+			override readonly sessionResource = resource;
+			override readonly onDidChange = changed.event;
+			override readonly requestInProgress = observableValue('requestInProgress', true);
+			override readonly lastRequestObs = constObservable(undefined);
+			override getRequests() { return [request]; }
+		};
+		let shown: IChatSessionItem['description'];
+		disposables.add(chatSessionsService.onDidChangeSessionItems(e => shown = e.addedOrUpdated?.[0]?.description));
+
+		// The controller's updates settle on resolved promises alone: one macrotask runs them all.
+		(instantiationService.get(IChatService) as MockChatService).addSession(model);
+		await timeout(0);
+		assert.strictEqual(shown, 'Collecting the result');
+
+		response.isComplete = true;
+		model.requestInProgress.set(false, undefined);
+		changed.fire({ kind: 'completedRequest', request });
+		await timeout(0);
+		assert.strictEqual(shown, 'From the provider');
+
+		mainThread.$unregisterChatSessionItemController(controllerHandle);
+	});
 });
 
 suite('ExtHostChatSessions', function () {
