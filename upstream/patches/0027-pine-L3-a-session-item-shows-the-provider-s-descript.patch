From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pine Drama Studio Authors <authors@example.invalid>
Date: Sat, 14 Nov 2026 11:39:33 -0800
Subject: [PATCH 27/27] pine(L3): a session item shows the provider's
 description again when its turn ends
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

While a turn runs, a session item's description is the model's latest progress (getInProgressSessionDescription) and
the provider's description once the turn ends. On every model change tryUpdateItemForModel rebuilt the item from the
existing item rather than from the provider's, so the progress text became the provider's description and stayed
after the turn: the Sessions list kept showing "Collecting the turn's result…" on a finished session.

The item keeps the provider's item it was built from (dto), and tryUpdateItemForModel rebuilds from that. isEqual
compares it too, so a newer provider item is kept even while a turn hides its description.

diff --git a/src/vs/workbench/api/browser/mainThreadChatSessions.ts b/src/vs/workbench/api/browser/mainThreadChatSessions.ts
index 147aaa89ab7..db8c4ca7a62 100644
--- a/src/vs/workbench/api/browser/mainThreadChatSessions.ts
+++ b/src/vs/workbench/api/browser/mainThreadChatSessions.ts
@@ -526,7 +526,7 @@ class MainThreadChatSessionItemController extends Disposable implements IChatSes
 		const resource = model.sessionResource;
 		const existing = this._items.get(resource);
 		if (existing) {
-			this.addOrUpdateItem(existing);
+			this.addOrUpdateItem(existing.dto); // pine: from the provider's item, not the one derived from the model, whose in-progress description outlived the turn
 		}
 	}
 
@@ -629,7 +629,7 @@ class MainThreadChatSessionItem implements IChatSessionItem {
 	readonly metadata?: { readonly [key: string]: unknown };
 	readonly legacyResource?: URI;
 
-	constructor(dto: Dto<IChatSessionItem>, model: IChatModel | undefined, detailOverrides: IChatDetail | undefined) {
+	constructor(readonly dto: Dto<IChatSessionItem>, model: IChatModel | undefined, detailOverrides: IChatDetail | undefined) { // pine: the provider's item, to derive from again
 		this.resource = URI.revive(dto.resource);
 		this.label = dto.label;
 		this.timing = dto.timing;
@@ -672,7 +672,8 @@ class MainThreadChatSessionItem implements IChatSessionItem {
 			&& stringOrMarkdownEqual(this.tooltip, other.tooltip)
 			&& this.archived === other.archived
 			&& equals(this.metadata, other.metadata)
-			&& isEqual(this.legacyResource, other.legacyResource);
+			&& isEqual(this.legacyResource, other.legacyResource)
+			&& equals(this.dto, other.dto); // pine: a newer provider item is kept though it derives the same
 	}
 }
 
