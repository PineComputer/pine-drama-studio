 suite('Pine project entry', () => {
-	test('Welcome dispatches the two existing project commands without replacing native Recent', () => {
+	test('Welcome declares the two existing project commands without replacing native Recent', () => {
 		assert.deepStrictEqual(pineWelcomeStartEntries.map(entry => entry.content.command), ['command:pineDrama.newProject', 'command:pineDrama.openProject']);
 	});
 
@@ -37,10 +38,30 @@ suite('Pine project entry', () => {
 			const selected = service.invokeFunction(accessor => CommandsRegistry.getCommand(prepareProjectChatCommand)!.handler(accessor));
 			await Promise.resolve(); assert.deepStrictEqual(calls, ['open', 'restore']);
 			resolveRestore();
-			assert.strictEqual(await selected, 'pine-computer:/episode');
+			assert.deepStrictEqual(await selected, { resource: 'pine-computer:/episode', isUntitledDraft: false });
 			assert.deepStrictEqual(calls, ['open', 'restore']);
 		} finally { service.dispose(); }
 	});
+	for (const input of ['text', 'attachments', 'empty', 'other-provider'] as const) {
+		test(`native untitled restoration reports ${input} without materializing a saved Chat`, async () => {
+			const service = new TestInstantiationService();
+			const resource = getNewChatSessionResource(input === 'other-provider' ? 'other-provider' : 'pine-computer');
+			const view = upcastPartial<ChatViewPane>({
+				whenSessionRestored: async () => {},
+				widget: upcastPartial<ChatWidget>({
+					viewModel: upcastPartial<NonNullable<ChatWidget['viewModel']>>({ sessionResource: resource }),
+					getInput: () => input === 'text' || input === 'other-provider' ? 'OFFLINE unsent draft' : '',
+					attachmentModel: upcastPartial<ChatWidget['attachmentModel']>({ attachments: input === 'attachments' ? [upcastPartial<ChatWidget['attachmentModel']['attachments'][number]>({ id: 'offline-script' })] : [] }),
+				}),
+			});
+			service.stub(IViewsService, upcastPartial<IViewsService>({ openView: async <T>() => view as T }));
+			try {
+				const restored = await service.invokeFunction(accessor => CommandsRegistry.getCommand(prepareProjectChatCommand)!.handler(accessor));
+				assert.deepStrictEqual(restored, { resource: resource.toString(), isUntitledDraft: input === 'text' || input === 'attachments' });
+			} finally { service.dispose(); }
+		});
+	}
+
 	test('explicit Sessions navigation temporarily reveals the native list without replacing Chat', async () => {
 		const service = new TestInstantiationService();
 		const changed = new Emitter<IChatWidgetViewModelChangeEvent>();
