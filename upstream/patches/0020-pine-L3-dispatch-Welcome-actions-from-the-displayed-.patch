+import assert from 'assert';
+import { $ } from '../../../../../base/browser/dom.js';
+import { Event } from '../../../../../base/common/event.js';
+import { DisposableStore, MutableDisposable } from '../../../../../base/common/lifecycle.js';
+import { ContextKeyExpr } from '../../../../../platform/contextkey/common/contextkey.js';
+import { GettingStartedPage, type IWelcomePageStartEntry } from '../../../welcomeGettingStarted/browser/gettingStarted.js';
+import type { GettingStartedIndexList } from '../../../welcomeGettingStarted/browser/gettingStartedList.js';
+import { pineWelcomeStartEntries } from '../../browser/pineWelcome.js';
+
+suite('Pine Welcome commands', () => {
+	test('native Start dispatch uses the entries its renderer displays', async () => {
+		// Exercise the real native renderer/dispatcher with Pine rows, even under the upstream test product.
+		// Only services unrelated to this route are stubbed; no production test hook or alternate dispatcher.
+		const page = Object.create(GettingStartedPage.prototype) as GettingStartedPage;
+		const calls: string[] = [];
+		const resources = new DisposableStore();
+		Object.assign(page, {
+			container: $('div'), startList: resources.add(new MutableDisposable<GettingStartedIndexList<IWelcomePageStartEntry>>()),
+			dispatchListeners: resources.add(new DisposableStore()),
+			contextService: { contextMatchesRules: () => true, onDidChangeContext: Event.None },
+			keybindingService: { lookupKeybinding: () => undefined },
+			commandService: { executeCommand: async (id: string) => { calls.push(id); } },
+			telemetryService: { publicLog2: () => {} },
+		});
+		const list = page['buildStartList']();
+		const displayed = list['entries']!;
+		const original = [...displayed];
+		try {
+			displayed.splice(0, displayed.length, ...pineWelcomeStartEntries.map((entry, order) => ({
+				id: entry.id, title: entry.title, description: entry.description, command: entry.content.command,
+				order, icon: { type: 'icon' as const, icon: entry.icon }, when: ContextKeyExpr.true(),
+			})));
+			list.rerender();
+			for (const entry of pineWelcomeStartEntries) {
+				assert.ok(list.getDomElement().querySelector(`[x-dispatch="selectStartEntry:${entry.id}"]`));
+				await page['runDispatchCommand']('selectStartEntry', entry.id);
+			}
+			assert.deepStrictEqual(calls, ['workbench.action.keepEditor', 'pineDrama.newProject', 'workbench.action.keepEditor', 'pineDrama.openProject']);
+		} finally {
+			displayed.splice(0, displayed.length, ...original);
+			resources.dispose();
+		}
+	});
+});
