diff --git a/src/vs/workbench/contrib/pine/test/browser/pineWelcome.test.ts b/src/vs/workbench/contrib/pine/test/browser/pineWelcome.test.ts
new file mode 100644
index 00000000000..9738313755a
--- /dev/null
+++ b/src/vs/workbench/contrib/pine/test/browser/pineWelcome.test.ts
@@ -0,0 +1,48 @@
+/*---------------------------------------------------------------------------------------------
