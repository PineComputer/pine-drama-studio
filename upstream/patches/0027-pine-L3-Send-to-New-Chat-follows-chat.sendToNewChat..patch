+						precondition: ContextKeyExpr.has('config.chat.sendToNewChat.enabled'), // pine: see contrib/pine/browser/pine.contribution.ts
 					}
 				}, {
 					id: MenuId.ChatEditorInlineExecute,
@@ -779,7 +780,8 @@ export class ChatEditingSessionSubmitAction extends SubmitAction {
