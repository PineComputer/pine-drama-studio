# One Pine environment. For another, keep another file and name it with PINE_DRAMA_ENV_FILE.
# One endpoint and one pk_ project key, under the Pine SDK's names.
# Copy to .env (ignored by git) and fill in the key.
# The values below are a local Pine stack's; for Pine itself, use the endpoint and the key from pinecomputer.io.
PINE_SANDBOX_ENDPOINT=http://lvh.me:18080
PINE_SANDBOX_API_KEY=
PINE_SANDBOX_CONTROL_HOST=api.lvh.me:18080
