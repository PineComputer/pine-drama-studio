{
  "name": "pine-drama",
  "displayName": "Pine Drama Studio",
  "description": "Pine Drama Studio's built-in extension.",
  "publisher": "pine",
  "version": "0.2.6",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.145.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:pineDrama.episodeCanvas",
    "onWebviewPanel:pineDrama.gallery",
    "onWebviewPanel:pineDrama.segEditor"
  ],
  "contributes": {
    "configuration": {
      "title": "Pine Drama Studio",
      "properties": {
        "pineDrama.chat.showTurnCost": {
          "type": "boolean",
          "default": false,
          "description": "Show the cost of each Pine turn as a line at the end of its reply in Chat. The cost is recorded either way, and shown wherever else the Studio shows it (Versions)."
        }
      }
    },
    "icons": {
      "pine-computer": {
        "description": "Pine Computer mark (lit), generated by scripts/build-pine-icon-font.py from brand/system/mark/favicon-lit.svg",
        "default": {
          "fontPath": "./media/pine-icons.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "commands": [
      {
        "command": "pineDrama.connection",
        "title": "Pine Computer…",
        "category": "Pine"
      },
      {
        "command": "pineDrama.newProject",
        "title": "New Project…",
        "category": "Pine"
      },
      {
        "command": "pineDrama.openProject",
        "title": "Open Project…",
        "category": "Pine"
      },
      {
        "command": "pineDrama.showConversations",
        "title": "Show Sessions",
        "category": "Pine",
        "icon": "$(pine-computer)"
      },
      {
        "command": "pineDrama.showWaiting",
        "title": "Show What Waits for You",
        "category": "Pine",
        "icon": "$(pine-computer)"
      },
      {
        "command": "pineDrama.stopAllComputers",
        "title": "Pine: Stop All Computers",
        "category": "Developer"
      },
      {
        "command": "pineDrama.attachFiles",
        "title": "Attach Files to Session…",
        "category": "Pine"
      },
      {
        "command": "pineDrama.refreshProject",
        "title": "Refresh",
        "category": "Pine",
        "icon": "$(refresh)"
      },
      {
        "command": "pineDrama.revealInFiles",
        "title": "Reveal in Files",
        "category": "Pine",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pineDrama.copyPath",
        "title": "Copy Path",
        "category": "Pine"
      },
      {
        "command": "pineDrama.openEpisodeCanvas",
        "title": "Open Canvas",
        "category": "Pine"
      },
      {
        "command": "pineDrama.openEpisodeCanvasToSide",
        "title": "Open Canvas to the Side",
        "category": "Pine"
      },
      {
        "command": "pineDrama.openSessionProject",
        "title": "Open Session's Project",
        "category": "Pine"
      },
      {
        "command": "pineDrama.canvas.zoomIn",
        "title": "Canvas: Zoom In",
        "category": "Pine"
      },
      {
        "command": "pineDrama.canvas.zoomOut",
        "title": "Canvas: Zoom Out",
        "category": "Pine"
      },
      {
        "command": "pineDrama.canvas.fit",
        "title": "Canvas: Fit",
        "category": "Pine"
      },
      {
        "command": "pineDrama.canvas.selectAll",
        "title": "Canvas: Select All Cards",
        "category": "Pine"
      },
      {
        "command": "pineDrama.review.submit",
        "title": "Submit and continue",
        "category": "Pine"
      },
      {
        "command": "pineDrama.goToEpisode",
        "title": "Go to Episode",
        "category": "Pine",
        "icon": "$(arrow-right)"
      },
      {
        "command": "pineDrama.startEpisode",
        "title": "Start Episode",
        "category": "Pine",
        "icon": "$(play)"
      },
      {
        "command": "pineDrama.openBible",
        "title": "Open Bible",
        "category": "Pine",
        "icon": "$(book)"
      },
      {
        "command": "pineDrama.openSegEditor",
        "title": "Open Seg Editor",
        "category": "Pine",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "pineDrama.openAssetsCanvas",
        "title": "Edit in Canvas",
        "category": "Pine",
        "icon": "$(type-hierarchy)"
      }
    ],
    "configurationDefaults": {
      "workbench.startupEditor": "welcomePageInEmptyWorkbench",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "chat.agentHost.claudeAgent.enabled": false,
      "chat.agentHost.codexAgent.enabled": false,
      "chat.implicitContext.enabled": {
        "panel": "never"
      },
      "chat.titleBar.signIn.enabled": false,
      "chat.requestQueuing.defaultAction": "queue",
      "chat.requestCancellation.enabled": false,
      "chat.sendToNewChat.enabled": false,
      "chat.editRequests": "none",
      "chat.persistentProgressVerbosity": "conversation",
      "chat.titleBar.openInAgentsWindow.enabled": false,
      "workbench.secondarySideBar.showLabels": true,
      "chat.viewSessions.orientation": "stacked",
      "workbench.tips.enabled": false,
      "extensions.ignoreRecommendations": true,
      "git.enabled": false,
      "debug.showInStatusBar": "never",
      "workbench.editor.empty.hint": "hidden",
      "files.readonlyInclude": {
        "**/v[0-9]*/**": true,
        "**/t[0-9][0-9]*/**": true
      },
      "chat.editor.localAgent.enabled": false
    },
    "chatSessions": [
      {
        "type": "pine-computer",
        "name": "pine",
        "displayName": "Pine Computer",
        "description": "Agents on Pine Computers",
        "icon": "$(pine-computer)",
        "welcomeTitle": "Pine Computer",
        "welcomeMessage": "Tell Pine what to make. In a project, say what to work on, for example: do episode 3.\n\nNo project yet? Create or open one, then drop a screenplay or brief into the message box: .txt, .md, .fountain, .docx, .pdf, .doc or .rtf.\n\nSending starts remote work, billed by Pine.",
        "inputPlaceholder": "Tell Pine what you want to make or change",
        "requiresCustomModels": true
      }
    ],
    "chatParticipants": [
      {
        "id": "pine-computer",
        "name": "pine",
        "fullName": "Pine Computer",
        "description": "Agents on Pine Computers"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "pine",
        "displayName": "Pine"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pineDrama.revealInFiles",
          "when": "false"
        },
        {
          "command": "pineDrama.copyPath",
          "when": "false"
        },
        {
          "command": "pineDrama.openEpisodeCanvas",
          "when": "pineDrama.projectOpen"
        },
        {
          "command": "pineDrama.openEpisodeCanvasToSide",
          "when": "pineDrama.projectOpen"
        },
        {
          "command": "pineDrama.canvas.zoomIn",
          "when": "activeWebviewPanelId == 'pineDrama.episodeCanvas'"
        },
        {
          "command": "pineDrama.canvas.zoomOut",
          "when": "activeWebviewPanelId == 'pineDrama.episodeCanvas'"
        },
        {
          "command": "pineDrama.canvas.fit",
          "when": "activeWebviewPanelId == 'pineDrama.episodeCanvas'"
        },
        {
          "command": "pineDrama.canvas.selectAll",
          "when": "activeWebviewPanelId == 'pineDrama.episodeCanvas'"
        },
        {
          "command": "pineDrama.review.submit",
          "when": "false"
        },
        {
          "command": "pineDrama.goToEpisode",
          "when": "false"
        },
        {
          "command": "pineDrama.startEpisode",
          "when": "false"
        },
        {
          "command": "pineDrama.openBible",
          "when": "pineDrama.projectOpen"
        }
      ],
      "view/title": [
        {
          "command": "pineDrama.refreshProject",
          "when": "view == pine.project",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pineDrama.openEpisodeCanvasToSide",
          "when": "view == pine.project && viewItem =~ /\\bepisode\\b/",
          "group": "navigation@0"
        },
        {
          "command": "pineDrama.revealInFiles",
          "when": "view == pine.project && viewItem =~ /stage/",
          "group": "2_files@1"
        },
        {
          "command": "pineDrama.copyPath",
          "when": "view == pine.project && viewItem =~ /stage/",
          "group": "2_files@2"
        },
        {
          "command": "pineDrama.goToEpisode",
          "when": "view == pine.project && viewItem =~ /decomposed/",
          "group": "navigation@1"
        },
        {
          "command": "pineDrama.startEpisode",
          "when": "view == pine.project && viewItem =~ /\\bstartable\\b/",
          "group": "inline@0"
        },
        {
          "command": "pineDrama.startEpisode",
          "when": "view == pine.project && viewItem =~ /\\bstartable\\b/",
          "group": "navigation@1"
        },
        {
          "command": "pineDrama.openBible",
          "when": "view == pine.project && viewItem =~ /scriptStep/",
          "group": "1_open@0"
        },
        {
          "command": "pineDrama.openEpisodeCanvas",
          "when": "view == pine.project && viewItem =~ /\\bepisode\\b/",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "pineDrama.openAssetsCanvas",
          "when": "activeWebviewPanelId == 'pineDrama.gallery'",
          "group": "navigation"
        }
      ],
      "chat/chatSessions": [
        {
          "command": "pineDrama.openSessionProject",
          "when": "chatSessionType == pine-computer",
          "group": "pine@1"
        }
      ]
    },
    "views": {
      "pine-production": [
        {
          "id": "pine.project",
          "name": "Project",
          "icon": "media/production.svg",
          "contextualTitle": "Production"
        },
        {
          "id": "pine.versions",
          "name": "Versions",
          "contextualTitle": "Production",
          "when": "pineDrama.projectOpen"
        }
      ],
      "pine-review": [
        {
          "id": "pine.sessionReview",
          "name": "Review"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pine-production",
          "title": "Production",
          "icon": "media/production.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "pine-review",
          "title": "Review",
          "icon": "$(checklist)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pine.project",
        "when": "!pineDrama.projectOpen && !pineDrama.projectElsewhere",
        "contents": "No drama project is open.\n[Open Project Folder](command:workbench.action.files.openFolder)"
      },
      {
        "view": "pine.project",
        "when": "pineDrama.projectElsewhere",
        "contents": "This project is open in another Pine Drama Studio window. Work on it there, or close that window and reload this one."
      },
      {
        "view": "pine.versions",
        "when": "pineDrama.projectOpen && !pineDrama.versionsShown",
        "contents": "Select an item in Project to see its versions, reviews and cost."
      },
      {
        "view": "pine.sessionReview",
        "contents": "Nothing waits for your decision in this folder. Reviews from this project’s conversations appear here; select a batch to open its message in Chat.\n[Open Recent…](command:workbench.action.openRecent)"
      }
    ],
    "keybindings": [
      {
        "command": "pineDrama.canvas.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'pineDrama.episodeCanvas' && !inputFocus && !textInputFocus"
      },
      {
        "command": "pineDrama.canvas.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'pineDrama.episodeCanvas' && !inputFocus && !textInputFocus"
      },
      {
        "command": "pineDrama.canvas.fit",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeWebviewPanelId == 'pineDrama.episodeCanvas' && !inputFocus && !textInputFocus"
      },
      {
        "command": "pineDrama.canvas.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "activeWebviewPanelId == 'pineDrama.episodeCanvas' && !inputFocus && !textInputFocus"
      }
    ],
    "languages": [
      {
        "id": "fountain",
        "aliases": [
          "Fountain"
        ],
        "extensions": [
          ".fountain"
        ]
      }
    ],
    "grammars": [
      {
        "language": "fountain",
        "scopeName": "text.source.fountain",
        "path": "./syntaxes/fountain.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "fountain-titleentry",
        "description": "A line drama-cli's screenplay validate records as titleentry (file_lines)"
      },
      {
        "id": "fountain-heading",
        "description": "A line drama-cli's screenplay validate records as heading (file_lines)"
      },
      {
        "id": "fountain-action",
        "description": "A line drama-cli's screenplay validate records as action (file_lines)"
      },
      {
        "id": "fountain-character",
        "description": "A line drama-cli's screenplay validate records as character (file_lines)"
      },
      {
        "id": "fountain-dialogue",
        "description": "A line drama-cli's screenplay validate records as dialogue (file_lines)"
      },
      {
        "id": "fountain-parenthetical",
        "description": "A line drama-cli's screenplay validate records as parenthetical (file_lines)"
      },
      {
        "id": "fountain-lyric",
        "description": "A line drama-cli's screenplay validate records as lyric (file_lines)"
      },
      {
        "id": "fountain-transition",
        "description": "A line drama-cli's screenplay validate records as transition (file_lines)"
      },
      {
        "id": "fountain-pagebreak",
        "description": "A line drama-cli's screenplay validate records as pagebreak (file_lines)"
      },
      {
        "id": "fountain-note",
        "description": "A line drama-cli's screenplay validate records as note (file_lines)"
      },
      {
        "id": "fountain-boneyard",
        "description": "A line drama-cli's screenplay validate records as boneyard (file_lines)"
      },
      {
        "id": "fountain-section",
        "description": "A line drama-cli's screenplay validate records as section (file_lines)"
      },
      {
        "id": "fountain-synopsis",
        "description": "A line drama-cli's screenplay validate records as synopsis (file_lines)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "fountain",
        "scopes": {
          "fountain-titleentry": [
            "keyword.other.title-page.fountain"
          ],
          "fountain-heading": [
            "keyword.other.class"
          ],
          "fountain-action": [
            "meta.paragraph.text"
          ],
          "fountain-character": [
            "entity.name.type"
          ],
          "fountain-dialogue": [
            "string"
          ],
          "fountain-parenthetical": [
            "variable.other"
          ],
          "fountain-lyric": [
            "markup.italic string"
          ],
          "fountain-transition": [
            "constant.numeric"
          ],
          "fountain-pagebreak": [
            "entity.other.pagebreak.fountain"
          ],
          "fountain-note": [
            "comment.block"
          ],
          "fountain-boneyard": [
            "comment.block.fountain"
          ],
          "fountain-section": [
            "markup.section.fountain"
          ],
          "fountain-synopsis": [
            "comment.block.fountain.synopses"
          ]
        }
      }
    ],
    "chatOutputRenderers": [
      {
        "viewType": "pine.review",
        "mimeTypes": [],
        "codeBlockLanguageIdentifiers": [
          "pine-review"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p canvas && tsc -p tsconfig.media.json && node canvas/build.mjs",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test --test-concurrency=4 --test-timeout=120000 --test-force-exit \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/vscode-webview": "1.57.5",
    "@vscode/codicons": "0.0.46-49",
    "@xyflow/react": "12.12.0",
    "esbuild": "0.25.10",
    "potpack": "1.0.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "typescript": "5.9.3"
  },
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatProvider",
    "chatParticipantPrivate",
    "chatParticipantAdditions",
    "chatOutputRenderer"
  ],
  "dependencies": {
    "@pinesandbox/computer": "^0.3.5",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "tar": "7.5.22"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The Studio reads drama projects and never runs code from them."
    }
  }
}
